<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SoundSwitch.Core\SoundSwitch.Core.csproj" />
    <ProjectReference Include="..\SoundSwitch.Windows\SoundSwitch.Windows.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>sound-switch</AssemblyName>
    <Version>1.0.0</Version>
    <Product>sound-switch</Product>
    <Description>Teclado MIDI como mixer de som e seletor de saída para Windows</Description>
    <RootNamespace>SoundSwitch.App</RootNamespace>
    <!-- DPI per-monitor vem do app.manifest (é o jeito do WPF); o aviso é só do WinForms. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms só para o NotifyIcon; evita ambiguidade de nomes com o WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\config\config.example.json" LogicalName="config.example.json" />
  </ItemGroup>

</Project>
