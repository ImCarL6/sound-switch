<Window x:Class="SoundSwitch.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="sound-switch overlay"
        Width="320" Height="72"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        IsHitTestVisible="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border x:Name="Card" CornerRadius="10" Padding="14,10,14,12" Margin="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="Glyph" Grid.Column="0" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Image x:Name="AppIcon" Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center"
                   Margin="0,0,10,0" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock x:Name="LabelText" Grid.Column="1" FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="ValueText" Grid.Column="2" FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />

            <Grid x:Name="BarTrackHost" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,9,0,0" Height="6" VerticalAlignment="Top">
                <Border x:Name="BarTrack" CornerRadius="3" />
                <Border x:Name="BarFill" CornerRadius="3" HorizontalAlignment="Left" Width="0" />
            </Grid>
            <TextBlock x:Name="DetailText" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0"
                       FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
